<% content_for(:title, "冒険画面") %>

<%= render "shared/upper_navigation" %>

<div class="p-5 space-y-6">
  <div class="bg-white p-5 rounded-xl border-2 border-slate-800 shadow-[2px_2px_0_rgba(15,23,42,1)] text-center font-black text-slate-800 space-y-4">
    <h2 class="text-lg text-fuchsia-500">
      <%= @adventure.ongoing? ? "冒険進行中" : "帰還完了" %>
    </h2>
    
    <p class="text-sm">ダンジョン: <%= @dungeon.name %></p>
    
    <div id="adventure_status">
	    <% if @adventure.ongoing? %>
        <%= render "ongoing", adventure: @adventure%>
      <% else %>
	      <%= render "result", adventure: @adventure%>
	    <% end %>
	  </div>
  </div>
	
	<div class="bg-white p-5 rounded-xl border-2 border-slate-800 shadow-[2px_2px_0_rgba(15,23,42,1)] space-y-4">
	  <h3 class="text-base font-black text-slate-800">冒険ログ</h3>
	  <%= render "event_log", adventure_events: @adventure_events %>
	</div>
</div>


<%# 新しいイベントがあれば adventure_events_list に追加 %>
<% @new_events.each do |event| %>
  <%= turbo_stream.prepend(
        "adventure_events_list",
        partial: "adventures/event",
        locals: { event: event } 
      ) %>
<% end %>

<%# 冒険が終了していたら result に置換 %>
<% unless @adventure.ongoing? %>
  <%= turbo_stream.replace(
    "adventure_status",
    partial: "adventures/result",
    locals: { adventure: @adventure }
  ) %>
<% end %>

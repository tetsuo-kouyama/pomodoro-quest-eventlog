<div id="active" class="bg-slate-200 p-4 rounded-xl border-2 border-slate-800 space-y-2">
  <% (1..OwnedMonster::MAX_PARTY_SIZE).each do |i| %>
    <% active_monster = monster_in_slot(active_monsters, i) %>
    <div class="bg-white p-3 rounded-lg flex justify-between items-center font-black text-sm text-slate-800 shadow-sm gap-3">
      
      <!-- 左側：スロット番号 ＋ ニックネーム領域 -->
      <div class="flex items-center gap-3 min-w-0 flex-1">
        <span class="text-slate-400 text-xs shrink-0 w-4"><%= i %></span>
        
        <% if active_monster %>
          <span class="block truncate min-w-0" title="<%= active_monster.nickname %>">
            <%= active_monster.nickname %>
          </span>
        <% else %>
          <span class="text-slate-400 font-normal">空きスロット</span>
        <% end %>
      </div>

      <!-- 右側：ステータス（Lv・総合力） ＋ 「外す」ボタン領域 -->
      <% if active_monster %>
        <div class="flex items-center gap-3 shrink-0">
          <span>Lv.<%= active_monster.level %></span>
          <span>総合力：<%= active_monster.total_power %></span>
          <%= link_to "外す", remove_monster_party_path(owned_monster_id: active_monster.id), data: { turbo_method: :patch }, class: "text-xs bg-slate-100 hover:bg-slate-200 border border-slate-300 px-3 py-1 rounded" %>
        </div>
      <% end %>

    </div>
  <% end %>
</div>
